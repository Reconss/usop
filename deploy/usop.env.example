# ============================================================================
# USOP 生产部署配置（deploy/usop-deploy.sh 读取；不要提交到 git）
# 分机部署时，每台机器各自维护一份，只改「本机」相关项。
# ============================================================================

# ---------- 基础 ----------
TZ=Asia/Shanghai
# 本机对外 IP：留空由脚本自动探测（多网卡机器请手工指定）
HOST_IP=
# 数据目录：建议独立数据盘，如 /data/usop
USOP_DATA_DIR=/data/usop
# 应用对外端口
USOP_PORT=3266
API_PORT=5001
# 镜像名（不走构建时可直接指定已有镜像）
USOP_IMAGE=usop-platform:1.0.0

# ---------- PostgreSQL（应用节点本地） ----------
PG_HOST=postgres
PG_PORT=5432
PG_DB=usop_security
PG_USER=usop
# 留空自动生成随机密码
PG_PASSWORD=
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=200

# ---------- Redis（应用节点本地） ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Kafka（数据节点） ----------
# 单机部署保持 kafka:29092；分机部署写「数据节点 IP:9092」（脚本 --data-host 会自动填）
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# 留空由脚本按 HOST_IP 生成：PLAINTEXT://<HOST_IP>:9092,PLAINTEXT_INTERNAL://kafka:29092
KAFKA_ADVERTISED_LISTENERS=
KAFKA_HEAP_OPTS="-Xms1g -Xmx1g"
# 日志保留小时数：Kafka 只做缓冲，ES 才是真相源，48h 足够回溯重放
KAFKA_LOG_RETENTION_HOURS=48
KAFKA_CLUSTER_ID=TUMghNssTfuY70MTwaCWkQ

# ---------- Elasticsearch（检索节点） ----------
# 单机部署保持 elasticsearch:9200；分机部署写「检索节点 IP:9200」
ES_HOSTS=http://elasticsearch:9200
ES_URL=http://elasticsearch:9200
ES_INDEX_PREFIX=usop-alerts
ES_JAVA_HEAP=4g

# ---------- Flink（数据节点） ----------
FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081
FLINK_REST_API=http://flink-jobmanager:8081
FLINK_SQL_GATEWAY_URL=http://flink-sql-gateway:8083
FLINK_JM_MEM=1600m
FLINK_TM_MEM=4096m
FLINK_TM_SLOTS=4

# ---------- 安全 ----------
# 留空自动生成
JWT_SECRET=
SECRET_KEY=
