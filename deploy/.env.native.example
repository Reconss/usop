# ============================================================================
# USOP 非容器部署 —— 组件连接信息配置模板
# ----------------------------------------------------------------------------
# 由 start_native.sh 读取；首次运行会自动从本文件复制为 deploy/.env.native。
#
# 两种典型用法：
#   A) 基础设施就在本机 Docker（默认，推荐开发调试）：
#      保持下面所有 localhost 地址不变，
#      运行 ./start_native.sh 会自动 docker compose -f docker-compose.infra.yml up -d
#   B) 基础设施全在别处（--no-infra）：
#      把下面每个地址改成对应主机 IP / 域名，然后
#      ./start_native.sh --no-infra
#
# ⚠️ 关键区分：
#   - KAFKA_BOOTSTRAP_SERVERS / ES_URL / REDIS_URL / DATABASE_URL / FLINK_*_URL
#     是【应用进程（Flask）】连接组件用的「宿主机可达地址」。
#   - KAFKA_BOOTSTRAP / PG_HOST / PG_PORT 是【Flink 关联作业】内嵌 SQL 里用的
#     「容器网内地址」，Flink 容器与 kafka/postgres 在同一网络，必须填服务名。
#     除非你了解后果，否则这两个不要改。
# ============================================================================

# ---------- 安全密钥（生产务必替换为强随机值）----------
SECRET_KEY=change-me-native-dev-secret
JWT_SECRET=change-me-native-dev-jwt

# ---------- PostgreSQL（关系型 / 业务数据）----------
# 应用连接串（Flask 用，localhost 可达）
DATABASE_URL=postgresql://usop:usop_password@localhost:5432/usop_security
# 以下供 Flink 关联作业回写 PG（容器内网地址，默认即 docker-compose.infra.yml 服务名）
PG_HOST=postgres
PG_PORT=5432
PG_DB=usop_security
PG_USER=usop
PG_PASSWORD=usop_password

# ---------- Redis（缓存 / 告警去重）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Elasticsearch（告警 / 日志真相源）----------
ES_HOSTS=http://localhost:9200
ES_URL=http://localhost:9200
ES_INDEX_PREFIX=usop-alerts

# ---------- Kafka（日志接入 / 缓冲）----------
# 应用侧消费 / 生产用「宿主机可达地址」（docker-compose.infra.yml 已把 9092 暴露到宿主机）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Flink 关联作业内嵌 SQL 使用的 broker（容器网内地址，默认即服务名 kafka:29092，勿改）
KAFKA_BOOTSTRAP=kafka:29092

# ---------- Flink（关联分析 / 流式作业）----------
# 应用向 Flink 提交作业用的「宿主机可达地址」
FLINK_JOBMANAGER_URL=http://localhost:8081
FLINK_REST_API=http://localhost:8081
FLINK_SQL_GATEWAY_URL=http://localhost:8083
# 宿主机上 flink-jobs 目录（后端读取 / 提交作业用）。
# ⚠️ 该值会被 start_native.sh 自动覆盖为仓库根目录下的 flink-jobs 绝对路径，这里仅为占位。
FLINK_JOBS_DIR=/abs/path/to/usop/flink-jobs

# ---------- Hermes AI Agent（可选，不接可保持 false）----------
USE_HERMES_PROXY=false
HERMES_BASE_URL=http://hermes-agent:8080

# ---------- 启动行为 ----------
# 跳过「大数据组件强依赖检查」，组件未全就绪也允许后端启动（用于分步调试）
SKIP_BIGDATA_CHECK=1
FLASK_PORT=5001
FLASK_ENV=development
FLASK_DEBUG=1
