# ============================================================================
# USOP 非容器部署 —— 组件连接信息配置模板
# ----------------------------------------------------------------------------
# 由 start_native.sh 读取；首次运行会自动从本文件复制为 deploy/.env.native。
#
# 三种典型用法（可按组件自由混搭）：
#   A) 基础设施全在本机 Docker（默认，推荐开发调试）：
#      所有 *_PROVIDER=docker，运行 ./start_native.sh 会自动
#      docker compose -f docker-compose.infra.yml up -d <对应服务>
#   B) 基础设施全在别处（--no-infra）：
#      所有 *_PROVIDER=external，把每个地址改成对应主机 IP / 域名，然后
#      ./start_native.sh --no-infra
#   C) 混搭（推荐生产/有托管组件时）：
#      例如 ES 用云上 Elastic、PG/Redis/Kafka/Flink 跑本地 Docker：
#      ES_PROVIDER=external + 其余保持 docker，脚本只起 PG/Redis/Kafka/Flink。
#      也可以反过来：PG 用云 RDS、其余本地 Docker。
#
# ⚠️ 关键区分：
#   - DATABASE_URL / REDIS_URL / ES_URL / KAFKA_BOOTSTRAP_SERVERS / FLINK_*_URL
#     是【应用进程（Flask）】连接组件用的「宿主机可达地址」。
#   - PG_HOST / PG_PORT / KAFKA_BOOTSTRAP 是【Flink 关联作业】内嵌 SQL 里用的
#     「组件网络内地址」。当 Flink 跑在 Docker 而 PG/Kafka 是外部独立部署时，
#     这两个必须填 Flink 容器能访问到的地址（通常是宿主 IP 或 host.docker.internal），
#     否则关联作业回写 PG / 消费 Kafka 会连不上。
# ============================================================================

# ---------- 安全密钥（生产务必替换为强随机值）----------
SECRET_KEY=change-me-native-dev-secret
JWT_SECRET=change-me-native-dev-jwt

# ============================================================================
# 组件部署方式：docker = 由本脚本经 docker-compose.infra.yml 启动；
#                external = 已在别处独立部署，仅按下方地址连接（不启 Docker）
# 任意混搭均可；若全部为 external，脚本自动等同 --no-infra。
# ============================================================================
PG_PROVIDER=docker
REDIS_PROVIDER=docker
ES_PROVIDER=docker
KAFKA_PROVIDER=docker
FLINK_PROVIDER=docker

# ---------- PostgreSQL（关系型 / 业务数据）----------
# 应用连接串（Flask 用，宿主机可达；external 时填云 RDS 等真实地址）
#   示例（云数据库）: postgresql://usop:****@pgm-xxxx.rds.aliyuncs.com:5432/usop_security
DATABASE_URL=postgresql://usop:usop_password@localhost:5432/usop_security
# 以下供 Flink 关联作业回写 PG（组件网络内地址）。
#   - PG_PROVIDER=docker 时默认即服务名 postgres，勿改；
#   - PG_PROVIDER=external 且 FLINK_PROVIDER=docker 时，填 host.docker.internal
#     或宿主真实 IP，保证 Flink 容器能连到外部 PG。
PG_HOST=postgres
PG_PORT=5432
PG_DB=usop_security
PG_USER=usop
PG_PASSWORD=usop_password

# ---------- Redis（缓存 / 告警去重）----------
# external 时填云 Redis / 自建 Redis 真实地址（如 r-bp1xxxx.redis.rds.aliyuncs.com）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Elasticsearch（告警 / 日志真相源）----------
# external 时填云 ES / 自建集群地址（如 https://my-es.es.ap-southeast-1.aws.found.io:9243）
# 注意：云 ES 多为 https 且需账号，Flask 侧通过 ES_USER/ES_PASSWORD/CA 配置鉴权
ES_HOSTS=http://localhost:9200
ES_URL=http://localhost:9200
ES_INDEX_PREFIX=usop-alerts
# 外部 ES 鉴权（Docker 版默认无鉴权，留空即可）
ES_USER=
ES_PASSWORD=
ES_USE_SSL=false

# ---------- Kafka（日志接入 / 缓冲）----------
# 应用侧消费 / 生产用「宿主机可达地址」（external 时填 MSK / 自建集群等）
#   示例（自建）: broker1:9092,broker2:9092,broker3:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Flink 关联作业内嵌 SQL 使用的 broker（组件网络内地址）。
#   - KAFKA_PROVIDER=docker 时默认即服务名 kafka:29092，勿改；
#   - KAFKA_PROVIDER=external 且 FLINK_PROVIDER=docker 时，填宿主 IP:9092
#     （需确保 Kafka 监听/通告了该外部可达地址）。
KAFKA_BOOTSTRAP=kafka:29092

# ---------- Flink（关联分析 / 流式作业）----------
# 应用向 Flink 提交作业用的「宿主机可达地址」（external 时填独立 Flink 集群入口）
FLINK_JOBMANAGER_URL=http://localhost:8081
FLINK_REST_API=http://localhost:8081
FLINK_SQL_GATEWAY_URL=http://localhost:8083
# 宿主机上 flink-jobs 目录（后端读取 / 提交作业用）。
# ⚠️ 该值会被 start_native.sh 自动覆盖为仓库根目录下的 flink-jobs 绝对路径，这里仅为占位。
# 若 FLINK_PROVIDER=external，请将 flink-jobs/*.jar 部署到该外部 Flink 集群，
# 且其网络内 PG/Kafka 地址（上方 PG_HOST/KAFKA_BOOTSTRAP）需对外部 Flink 可达。
FLINK_JOBS_DIR=/abs/path/to/usop/flink-jobs

# ---------- Hermes AI Agent（可选，不接可保持 false）----------
USE_HERMES_PROXY=false
HERMES_BASE_URL=http://hermes-agent:8080

# ---------- 启动行为 ----------
# 跳过「大数据组件强依赖检查」，组件未全就绪也允许后端启动（用于分步调试）
SKIP_BIGDATA_CHECK=1
FLASK_PORT=5001
FLASK_ENV=development
FLASK_DEBUG=1
