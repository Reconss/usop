# ==================== Flask 配置 ====================
SECRET_KEY=usop-secret-key-dev-local
JWT_SECRET=usop-jwt-secret-dev-local
FLASK_ENV=development
FLASK_DEBUG=1

# ==================== PostgreSQL 配置 (关系型数据) ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=usop
DB_PASSWORD=usop_password
DB_NAME=usop_security

# SQLAlchemy 数据库 URL
DATABASE_URL=postgresql://usop:usop_password@localhost:5432/usop_security

# ==================== TimescaleDB 配置 (时序数据) ====================
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_USER=postgres
TSDB_PASSWORD=postgres
TSDB_NAME=postgres

# ==================== Redis 配置 (Docker) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Kafka 配置 (Docker) ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# ==================== 服务端口 ====================
PORT=5001
