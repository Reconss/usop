FROM flink:1.18.1-scala_2.12-java11

USER root

# 安装 JDK（pemja 需要 JDK headers）、编译工具、Python3 + pip
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        openjdk-11-jdk \
        build-essential \
        python3 \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 确保 JAVA_HOME 指向正确的 JDK 路径
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-arm64
ENV PATH=$JAVA_HOME/bin:$PATH

# 创建 python -> python3 软链接（Flink 需要）
RUN ln -s /usr/bin/python3 /usr/bin/python

# 安装 PyFlink（与 Flink 版本匹配）
RUN pip3 install apache-flink==1.18.1 kafka-python redis --no-cache-dir

# 下载 Flink Kafka connector 依赖 JAR（PyFlink 需要）
RUN curl -sL -o /opt/flink/lib/flink-connector-kafka-3.2.0-1.18.jar \
    "https://repo1.maven.org/maven2/org/apache/flink/flink-connector-kafka/3.2.0-1.18/flink-connector-kafka-3.2.0-1.18.jar" && \
    curl -sL -o /opt/flink/lib/kafka-clients-3.4.0.jar \
    "https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.4.0/kafka-clients-3.4.0.jar"

# 恢复 flink 用户
USER flink
