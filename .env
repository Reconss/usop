# ==================== 数据库配置 ====================
DB_USER=usop
DB_PASSWORD=usop_password
DB_NAME=usop_security
DB_PORT=5432

# ==================== Elasticsearch 配置 ====================
# 用于存储告警日志时序数据（替代 TimescaleDB）
ES_HOSTS=http://localhost:9200
ES_INDEX_PREFIX=usop-alerts
ES_ILM_ENABLED=true

# ==================== Redis 配置 ====================
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# ==================== Flask 配置 ====================
FLASK_ENV=production
SECRET_KEY=usop-secret-key-local-dev
JWT_SECRET=usop-jwt-secret-local-dev

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== 服务端口 ====================
BACKEND_PORT=5001
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# ==================== API 配置 ====================
API_BASE_URL=http://backend:5001/api

# ==================== AI / DeepSeek 配置 ====================
AI_ANALYSIS_ENABLED=false
DEEPSEEK_API_KEY=sk-584f839ec3f04d8c95b93e79cf485ce9
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== Hermes AI Agent 配置 ====================
HERMES_BASE_URL=http://hermes-agent:8080
USE_HERMES_PROXY=true
