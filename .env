# ==================== 数据库配置 ====================
DB_USER=usop
DB_PASSWORD=usop_password
DB_NAME=usop_security
DB_PORT=5432

# ==================== TimescaleDB 配置 ====================
# 用于存储告警日志时序数据
TSDB_USER=timescale
TSDB_PASSWORD=timescale_pass
TSDB_NAME=alerts
TSDB_HOST=localhost
TSDB_PORT=5433

# ==================== Redis 配置 ====================
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# ==================== Flask 配置 ====================
FLASK_ENV=production
SECRET_KEY=usop-secret-key-local-dev
JWT_SECRET=usop-jwt-secret-local-dev

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== 服务端口 ====================
BACKEND_PORT=5001
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# ==================== API 配置 ====================
API_BASE_URL=http://backend:5001/api

# ==================== AI / DeepSeek 配置 ====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== Hermes AI Agent 配置 ====================
# Hermes 容器内地址（Docker 网络）
HERMES_BASE_URL=http://hermes-agent:8080
# 是否通过 Hermes 代理调用 DeepSeek（false=后端直连 DeepSeek）
USE_HERMES_PROXY=false
