[
  {
    "name": "恶意IP自动封禁",
    "description": "当检测到攻击行为时，自动封禁源IP并发送通知",
    "triggerType": "告警事件",
    "enabled": false,
    "nodes": [
      {
        "id": "n1",
        "typeId": "trigger",
        "name": "触发器",
        "config": {
          "triggerType": "告警事件"
        },
        "position": {
          "x": 100,
          "y": 100
        },
        "outputs": [
          "n2"
        ]
      },
      {
        "id": "n2",
        "typeId": "condition",
        "name": "严重度判断",
        "config": {
          "field": "severity",
          "operator": "等于",
          "value": "critical"
        },
        "position": {
          "x": 300,
          "y": 100
        },
        "outputs": [
          "n3"
        ]
      },
      {
        "id": "n3",
        "typeId": "block",
        "name": "封禁IP",
        "config": {
          "ip": "{{src_ip}}",
          "duration": "24h",
          "reason": "恶意攻击自动封禁"
        },
        "position": {
          "x": 500,
          "y": 50
        },
        "outputs": [
          "n4"
        ]
      },
      {
        "id": "n4",
        "typeId": "notify",
        "name": "发送通知",
        "config": {
          "channel": "企业微信",
          "title": "IP封禁告警",
          "content": "已自动封禁攻击源IP: {{src_ip}}"
        },
        "position": {
          "x": 700,
          "y": 100
        },
        "outputs": []
      }
    ]
  },
  {
    "name": "主机异常隔离",
    "description": "检测到主机异常行为时，自动隔离并通知",
    "triggerType": "告警事件",
    "enabled": false,
    "nodes": [
      {
        "id": "n1",
        "typeId": "trigger",
        "name": "触发器",
        "config": {
          "triggerType": "告警事件"
        },
        "position": {
          "x": 100,
          "y": 100
        },
        "outputs": [
          "n2"
        ]
      },
      {
        "id": "n2",
        "typeId": "condition",
        "name": "主机存在?",
        "config": {
          "field": "hostname",
          "operator": "is_not_empty",
          "value": ""
        },
        "position": {
          "x": 300,
          "y": 100
        },
        "outputs": [
          "n3"
        ]
      },
      {
        "id": "n3",
        "typeId": "isolate",
        "name": "隔离主机",
        "config": {
          "hostname": "{{hostname}}",
          "duration": "2h"
        },
        "position": {
          "x": 500,
          "y": 50
        },
        "outputs": [
          "n4"
        ]
      },
      {
        "id": "n4",
        "typeId": "notify",
        "name": "发送通知",
        "config": {
          "channel": "企业微信",
          "title": "主机隔离通知",
          "content": "主机 {{hostname}} 已自动隔离"
        },
        "position": {
          "x": 700,
          "y": 100
        },
        "outputs": []
      }
    ]
  },
  {
    "name": "工单自动创建",
    "description": "高危告警自动创建安全工单",
    "triggerType": "告警事件",
    "enabled": false,
    "nodes": [
      {
        "id": "n1",
        "typeId": "trigger",
        "name": "触发器",
        "config": {
          "triggerType": "告警事件"
        },
        "position": {
          "x": 100,
          "y": 100
        },
        "outputs": [
          "n2"
        ]
      },
      {
        "id": "n2",
        "typeId": "ticket",
        "name": "创建工单",
        "config": {
          "title": "安全告警处理: {{title}}",
          "priority": "高",
          "assignee": "安全运维"
        },
        "position": {
          "x": 300,
          "y": 100
        },
        "outputs": [
          "n3"
        ]
      },
      {
        "id": "n3",
        "typeId": "notify",
        "name": "通知",
        "config": {
          "channel": "企业微信",
          "title": "新工单提醒",
          "content": "已创建安全工单: {{title}}"
        },
        "position": {
          "x": 500,
          "y": 100
        },
        "outputs": []
      }
    ]
  }
]