  "testScenarios": [
    {
      "id": "TS-001",
      "name": "规则创建测试",
      "description": "测试新建检测规则功能",
      "steps": [
        "1. 点击「新建规则」按钮",
        "2. 在基本信息Tab填写规则名称、选择类型、设置严重度",
        "3. 切换到数据源Tab，选择关联的数据源",
        "4. 切换到检测条件Tab，编写检测逻辑",
        "5. 切换到响应动作Tab，选择关联剧本",
        "6. 点击「创建」按钮",
        "7. 验证Toast提示「规则已创建」"
      ],
      "expectedResult": "规则成功创建并显示在列表中"
    },
    {
      "id": "TS-002",
      "name": "规则编辑测试",
      "description": "测试编辑现有规则功能",
      "steps": [
        "1. 在规则列表中找到「测试-暴力破解检测」(ID: 1001)",
        "2. 点击编辑按钮打开编辑弹窗",
        "3. 修改规则描述",
        "4. 切换严重度选择",
        "5. 点击「保存」按钮",
        "6. 验证Toast提示「规则已更新」"
      ],
      "expectedResult": "规则信息成功更新"
    },
    {
      "id": "TS-003",
      "name": "规则删除测试",
      "description": "测试删除规则功能",
      "steps": [
        "1. 在规则列表中找到「测试-数据外泄检测」(ID: 1005)",
        "2. 点击删除按钮",
        "3. 在确认对话框中点击「确定」",
        "4. 验证Toast提示「规则已删除」"
      ],
      "expectedResult": "规则从列表中移除"
    },
    {
      "id": "TS-004",
      "name": "规则测试功能",
      "description": "测试规则匹配测试功能",
      "steps": [
        "1. 在规则列表中找到「测试-SQL注入检测」(ID: 1006)",
        "2. 点击测试按钮(播放图标)",
        "3. 等待测试完成",
        "4. 查看测试结果弹窗中的匹配数量和日志"
      ],
      "expectedResult": "显示测试匹配结果，包括匹配数量和日志样本"
    },
    {
      "id": "TS-005",
      "name": "规则搜索测试",
      "description": "测试规则搜索和筛选功能",
      "steps": [
        "1. 在搜索框输入「暴力破解」",
        "2. 验证只显示包含该关键词的规则",
        "3. 清空搜索框，输入「单事件」",
        "4. 验证只显示类型为单事件的规则"
      ],
      "expectedResult": "搜索和筛选功能正常工作"
    },
    {
      "id": "TS-006",
      "name": "规则启用/禁用",
      "description": "测试规则状态切换功能",
      "steps": [
        "1. 找到「测试-数据外泄检测」(ID: 1005)，状态当前为「禁用」",
        "2. 点击状态开关启用规则",
        "3. 验证规则状态变为「启用」",
        "4. 再次点击开关禁用规则"
      ],
      "expectedResult": "规则状态正常切换"
    },
    {
      "id": "TS-007",
      "name": "告警聚合功能测试",
      "description": "测试将多个告警聚合生成事件",
      "steps": [
        "1. 进入告警管理页面",
        "2. 选择以下告警: 2003, 2006, 2007, 2008 (均为critical级别)",
        "3. 点击「聚合生成事件」按钮",
        "4. 在弹窗中填写: 标题「测试-重大安全事件」、描述、严重度",
        "5. 点击「生成」按钮",
        "6. 验证成功后跳转到事件工作台"
      ],
      "expectedResult": "事件成功创建，相关告警关联到该事件"
    },
    {
      "id": "TS-008",
      "name": "数据源关联测试",
      "description": "测试规则与数据源的关联",
      "steps": [
        "1. 编辑规则「测试-暴力破解检测」",
        "2. 切换到数据源Tab",
        "3. 勾选「测试-防火墙日志」和「测试-主机日志」",
        "4. 保存规则",
        "5. 重新编辑该规则",
        "6. 验证已选择的数据源正确显示"
      ],
      "expectedResult": "数据源关联信息正确保存和显示"
    }
  ]
}
